/* UiTheme::apply resolves colors from the palette and spacing from the layout. */
QWidget { color: @text@; selection-background-color: @selection@; selection-color: @selectionText@; }
QMainWindow, QWidget#root, QWidget#settingsPage { background: @surface@; }
QDialog, QMessageBox, QInputDialog { background: @surface@; }
QLabel { background: transparent; }
QFrame#sidebar { background: @sidebar@; border: none; border-right: 1px solid @border@; }
QFrame#windowHeader { background: @header@; border: none; border-bottom: 1px solid @border@; }
QWidget[workspaceSurface="content"] {
    background: @surface@; border: none; border-radius: 0;
}
QWidget[workspaceSurface="index"], QWidget[workspaceSurface="inset"] {
    background: @indexSurface@; border: none; border-radius: 0;
}
QWidget[workspaceSurface="section"] {
    background: @surface@; border: none; border-bottom: 1px solid @border@; border-radius: 0;
}
QLabel#contentTitle, QLabel#objectTitle { color: @text@; font-size: 20px; font-weight: 600; }
QLabel#cardTitle { color: @text@; font-size: 16px; font-weight: 600; }
QLabel#toolName { color: @text@; font-size: 22px; font-weight: 600; }
QLabel#emptyStateTitle { color: @text@; font-size: 18px; font-weight: 600; }
QLabel#muted, QLabel#sourceText, QLabel#fieldHelp, QLabel#recordHint, QLabel#mathPreviewStatus {
    color: @muted@; font-size: 12px;
}
QLabel#emptyViewHint { color: @muted@; font-size: 13px; padding: 20px; }
QLabel#emptyStateMessage { color: @muted@; font-size: 13px; }
QLabel#selectedDate { color: @muted@; font-size: 13px; }
QLabel#recordSaveStatus { font-size: 12px; }
QLabel[uiRole="muted"] { color: @muted@; }
QLabel[uiRole="error"], QLabel#clipboardStatus { color: @danger@; }
QLabel[uiRole="success"] { color: @success@; }
QLabel[uiRole="warning"] { color: @warning@; }
QLabel[uiRole="accent"] { color: @accent@; }
QWidget#updateWidget {
    background: @surface@; border: 1px solid @border@; border-radius: 10px;
}
QPushButton, QToolButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 @buttonTop@, stop:0.4 @controlSurface@, stop:0.65 @controlSurface@, stop:1 @buttonBottom@);
    color: @controlText@; border: 1px solid @buttonEdge@; border-bottom-color: @controlBorder@;
    border-radius: @controlRadius@; padding: @controlPadding@; min-height: 20px;
}
QPushButton:hover, QToolButton:hover { background: @controlHover@; border-color: @focus@; }
QPushButton:checked, QToolButton:checked { background: @selection@; color: @selectionText@; border-color: @focus@; }
QPushButton:pressed, QToolButton:pressed { background: @controlPressed@; border-color: @focus@; }
QPushButton:focus, QToolButton:focus { border-color: @accent@; }
QPushButton[uiRole="quiet"], QToolButton[uiRole="quiet"] { background: transparent; color: @text@; border-color: transparent; }
QPushButton[uiRole="quiet"]:hover, QToolButton[uiRole="quiet"]:hover { background: @hover@; }
QPushButton[uiRole="quiet"]:pressed, QToolButton[uiRole="quiet"]:pressed { background: @selection@; }
QPushButton[uiRole="quiet"]:focus, QToolButton[uiRole="quiet"]:focus { border-color: @focus@; }
QPushButton#refreshStateButton { padding: 6px; }
QPushButton#gitHistoryButton:enabled { color: @selectionText@; background: @selection@; border-color: @controlBorder@; font-weight: 600; }
QPushButton#gitHistoryButton:enabled:hover { color: @primaryText@; background: @primaryHover@; border-color: @focus@; }
QPushButton#gitHistoryButton:enabled:pressed { color: @primaryText@; background: @primaryPressed@; border-color: @focus@; }
QPushButton#gitHistoryButton:enabled:focus { border-color: @accent@; }
QPushButton#gitHistoryButton:disabled { color: @disabled@; background: transparent; border-color: transparent; font-weight: 400; }
QPushButton:disabled, QToolButton:disabled,
QPushButton[uiRole="quiet"]:disabled, QToolButton[uiRole="quiet"]:disabled {
    color: @disabled@; background: @background@; border-color: @border@;
}
QPushButton#primaryButton, QPushButton[uiRole="primary"], QToolButton[uiRole="primary"], QPushButton:default {
    background: @primaryBackground@; color: @primaryText@; border-color: @primaryBorder@; border-bottom-color: @primaryEdge@; font-weight: 600;
}
QPushButton#primaryButton:hover, QPushButton[uiRole="primary"]:hover, QToolButton[uiRole="primary"]:hover, QPushButton:default:hover { background: @primaryHover@; border-color: @primaryHoverBorder@; }
QPushButton#primaryButton:pressed, QPushButton[uiRole="primary"]:pressed, QToolButton[uiRole="primary"]:pressed, QPushButton:default:pressed { background: @primaryPressed@; border-color: @focus@; }
QPushButton#primaryButton:focus:enabled, QPushButton[uiRole="primary"]:focus:enabled, QToolButton[uiRole="primary"]:focus:enabled, QPushButton:default:focus:enabled { border-color: @accent@; }
QPushButton#primaryButton:disabled, QPushButton[uiRole="primary"]:disabled, QToolButton[uiRole="primary"]:disabled, QPushButton:default:disabled { color: @disabled@; background: @background@; border-color: @border@; }
QPushButton#dangerButton, QPushButton[uiRole="danger"], QToolButton[uiRole="danger"], QPushButton#deleteProjectButton { color: @danger@; background: transparent; border-color: transparent; }
QPushButton#dangerButton:hover, QPushButton[uiRole="danger"]:hover, QToolButton[uiRole="danger"]:hover, QPushButton#deleteProjectButton:hover { background: @dangerBackground@; border-color: @dangerHoverBorder@; }
QPushButton#dangerButton:focus, QPushButton[uiRole="danger"]:focus, QToolButton[uiRole="danger"]:focus, QPushButton#deleteProjectButton:focus { border-color: @danger@; }
QPushButton[uiRole="danger"]:disabled, QToolButton[uiRole="danger"]:disabled, QPushButton#dangerButton:disabled, QPushButton#deleteProjectButton:disabled { color: @disabled@; background: transparent; border-color: transparent; }
QPushButton#navButton { color: @text@; background: transparent; border: 1px solid transparent; border-left-width: 3px; text-align: left; padding: @navPadding@; min-height: 24px; font-size: 14px; border-radius: @navRadius@; }
QPushButton#navButton[uiRole="collapsedNav"] { text-align: center; padding-left: 0; padding-right: 0; }
QPushButton#navButton:hover { background: @navHover@; }
QPushButton#navButton:checked { background: @selection@; color: @selectionText@; border-color: @border@; border-left-color: @accent@; font-weight: 600; }
QPushButton#navButton:focus { border-color: @focus@; }
QPushButton#navButton:checked:focus { border-left-color: @accent@; }
QPushButton#sidebarToggle { background: transparent; padding: 0; min-width: 32px; max-width: 32px; min-height: 28px; max-height: 28px; border-color: transparent; }
QPushButton#sidebarToggle:hover { background: @navHover@; }
QPushButton#sidebarToggle:pressed { background: @selection@; }
QPushButton#sidebarToggle:focus { border-color: @focus@; }
QLineEdit, QPlainTextEdit, QTextEdit, QAbstractSpinBox, QComboBox {
    background: @surface@; color: @text@; border: 1px solid @controlBorder@;
    border-radius: @controlRadius@; padding: @inputPadding@; placeholder-text-color: @muted@;
}
QLineEdit:hover, QComboBox:hover, QAbstractSpinBox:hover { border-color: @focus@; }
QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus, QAbstractSpinBox:focus, QComboBox:focus { border-color: @accent@; }
QLineEdit:disabled, QAbstractSpinBox:disabled, QComboBox:disabled { color: @disabled@; background: @background@; border-color: @border@; }
QLineEdit[readOnly="true"] { background: @background@; border-color: @border@; }
QLineEdit#recordSearch { background: @indexSurface@; border-color: transparent; }
QLineEdit#clipboardSearch { background: @surface@; border-color: @buttonEdge@; }
QLineEdit#clipboardSearch QToolButton { background: transparent; border: none; min-height: 0; padding: 0; }
QLineEdit#recordSearch:hover, QLineEdit#clipboardSearch:hover { border-color: @controlBorder@; }
QLineEdit#recordSearch:focus, QLineEdit#clipboardSearch:focus { border-color: @focus@; }
QPlainTextEdit#headingSource, QTextEdit#headingPreview { padding: 12px 14px; }
QTextEdit#headingPreview { border-color: @border@; }
QTextEdit#headingPreview:focus { border-color: @accent@; }
QFrame#clipboardTabStrip { background: @surface@; border: none; border-bottom: 1px solid @border@; }
QFrame#clipboardActionBar { background: @surface@; border: none; border-top: 1px solid @border@; }
QPushButton#clipboardNewItem { min-width: 48px; }
QLabel#clipboardPreviewMeta { color: @muted@; font-size: 12px; }
QPlainTextEdit#clipboardPreview { background: @surface@; border: 1px solid transparent; border-radius: 4px; padding: 2px 0; }
QPlainTextEdit#clipboardPreview:focus { border-color: @focus@; }
QTreeWidget#clipboardItems { font-size: @clipboardListSize@; }
QPlainTextEdit#clipboardPreview, QPlainTextEdit#clipboardItemBody { font-size: 12pt; }
QComboBox { background: @controlSurface@; color: @controlText@; padding-right: 28px; min-height: 20px; }
QComboBox#appearancePalette { min-width: 7em; }
QComboBox#appearanceLayout { min-width: 3em; }
QComboBox::drop-down { subcontrol-origin: padding; subcontrol-position: center right; width: 26px; border: none; }
QComboBox::down-arrow { image: url(@chevronDownIcon@); width: 12px; height: 12px; }
QComboBox QAbstractItemView { background: @surface@; border: 1px solid @controlBorder@; padding: 4px; selection-background-color: @selection@; selection-color: @selectionText@; }
QComboBox[uiRole="appearanceChoice"] { combobox-popup: 0; combobox-list-mousetracking: 1; min-height: 24px; border-color: @buttonEdge@; border-bottom-color: @controlBorder@; }
QComboBox[uiRole="appearanceChoice"]:hover { background: @hover@; }
QComboBox[uiRole="appearanceChoice"]:focus { border-color: @accent@; }
QComboBox[uiRole="appearanceChoice"]:on { background: @controlSurface@; border-color: @accent@; }
QComboBox[uiRole="appearanceChoice"]::down-arrow:on { image: url(@chevronUpIcon@); }
QFrame[uiRole="appearancePopup"] { background: transparent; border: none; }
QAbstractItemView[uiRole="appearanceOptions"] { background: @surface@; border: 1px solid @controlBorder@; border-radius: 8px; padding: 4px; outline: 0; }
QAbstractItemView[uiRole="appearanceOptions"]::item { padding: @choiceItemPadding@; border: none; border-radius: 4px; }
QAbstractItemView[uiRole="appearanceOptions"]::item:hover { background: @hover@; }
QAbstractItemView[uiRole="appearanceOptions"]::item:selected { background: @selection@; color: @selectionText@; }
QAbstractSpinBox { padding-right: 24px; min-height: 20px; }
QAbstractSpinBox::up-button, QAbstractSpinBox::down-button { subcontrol-origin: border; width: 22px; border: none; border-left: 1px solid @border@; }
QAbstractSpinBox::up-button { subcontrol-position: top right; border-top-right-radius: 6px; }
QAbstractSpinBox::down-button { subcontrol-position: bottom right; border-bottom-right-radius: 6px; }
QAbstractSpinBox::up-button:hover, QAbstractSpinBox::down-button:hover { background: @selection@; }
QAbstractSpinBox::up-arrow { image: url(@chevronUpIcon@); width: 10px; height: 10px; }
QAbstractSpinBox::down-arrow { image: url(@chevronDownIcon@); width: 10px; height: 10px; }
QCheckBox, QRadioButton { spacing: 8px; padding: 3px 0; }
QCheckBox:disabled, QRadioButton:disabled { color: @disabled@; }
QCheckBox::indicator { width: 16px; height: 16px; border: 1px solid @controlBorder@; border-radius: 4px; background: @surface@; }
QCheckBox::indicator:checked { background: @checkFill@; border-color: @focus@; image: url(@checkIcon@); }
QCheckBox::indicator:hover, QCheckBox::indicator:focus { border-color: @accent@; }
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled { background: @background@; border-color: @border@; }
QCheckBox::indicator:checked:disabled { image: url(@checkDisabledIcon@); }
QRadioButton::indicator { width: 16px; height: 16px; border: 1px solid @controlBorder@; border-radius: 8px; background: @surface@; }
QRadioButton::indicator:checked { background: @checkFill@; border-color: @focus@; image: url(@radioIcon@); }
QRadioButton::indicator:hover { border-color: @accent@; }
QRadioButton::indicator:checked:disabled { background: @background@; border-color: @border@; image: url(@radioDisabledIcon@); }
QListWidget, QTreeWidget, QTableView { background: @surface@; alternate-background-color: @background@; border: 1px solid @border@; border-radius: 6px; padding: 4px; }
QListWidget::item, QTreeWidget::item { padding: @itemPadding@; border: 1px solid transparent; border-radius: 4px; }
QListWidget::item:hover, QTreeWidget::item:hover { background: @hover@; }
QListWidget::item:selected, QTreeWidget::item:selected { background: @selection@; color: @selectionText@; }
QListWidget::item:focus, QTreeWidget::item:focus { border-color: @focus@; }
QListWidget#projectList, QTreeWidget#workRecordList, QTreeWidget#toolTree,
QListWidget#reminderList, QListWidget#diaryList, QTreeWidget#clipboardItems { border: none; background: transparent; padding: 0; }
QTreeWidget#toolTree::item { padding: @toolItemPadding@; }
/* Minimums exclude the 1px borders; normal rows retain their 44/42/48px heights. */
QListWidget#projectList::item, QTreeWidget#workRecordList::item { min-height: @recordMinHeight@; padding-top: 0; padding-bottom: 0; }
QListWidget#diaryList::item { min-height: @diaryMinHeight@; padding-top: 0; padding-bottom: 0; }
QListWidget#diaryCollectionList::item { min-height: @collectionMinHeight@; padding-top: 0; padding-bottom: 0; }
QTreeWidget#clipboardItems::item { min-height: @clipboardRowHeight@; padding: 0 6px; border: none; border-bottom: 1px solid @border@; border-radius: 0; }
QTreeWidget#clipboardItems::item:focus { border-bottom-color: @focus@; }
QTreeWidget::branch { background: transparent; }
QTreeWidget::branch:has-children:closed { image: url(@chevronRightIcon@); }
QTreeWidget::branch:has-children:open { image: url(@chevronDownIcon@); }
QHeaderView::section { background: @background@; color: @muted@; border: none; border-bottom: 1px solid @border@; padding: 7px; }
QTabBar::tab { color: @muted@; background: transparent; border: 1px solid transparent; border-radius: @controlRadius@; padding: @tabPadding@; margin-right: 4px; min-width: 36px; min-height: 20px; }
QTabBar::tab:hover { background: @hover@; }
QTabBar::tab:selected { color: @selectionText@; background: @selection@; border-color: @controlBorder@; font-weight: 600; }
QTabBar::tab:focus { border-color: @accent@; }
QTabBar#recordSectionTabs::tab:last { margin-right: 0; }
QTabBar#projectStatusTabs::tab { color: @text@; border-color: @controlBorder@; border-radius: 0; margin-right: 0; }
QTabBar#projectStatusTabs::tab:first { border-top-left-radius: 6px; border-bottom-left-radius: 6px; }
QTabBar#projectStatusTabs::tab:last { border-top-right-radius: 6px; border-bottom-right-radius: 6px; margin-left: -1px; }
QTabBar#projectStatusTabs::tab:selected { color: @selectionText@; background: @selection@; }
QTabBar#projectStatusTabs::tab:focus { border-color: @accent@; }
QTabBar#clipboardTabs { font-size: 10pt; }
QTabBar#clipboardTabs::tab { background: transparent; color: @muted@; border: 1px solid transparent; border-bottom-width: 2px; border-radius: 0; margin-right: 6px; padding: @tabPadding@; min-height: 22px; max-width: 220px; }
QTabBar#clipboardTabs::tab:last { margin-right: 0; }
QTabBar#clipboardTabs::tab:hover { background: @hover@; color: @text@; }
QTabBar#clipboardTabs::tab:selected { background: @surface@; color: @accent@; border-bottom-color: @accent@; font-weight: 600; }
QTabBar#clipboardTabs::tab:focus { border-color: @focus@; }
QTabBar#clipboardTabs::scroller { width: 64px; }
QTabBar#clipboardTabs QToolButton { padding: 0; }
QTabWidget::pane { border: 1px solid @border@; border-radius: 6px; background: @surface@; }
QFrame#summaryField { background: @surface@; border: none; }
QLabel#summaryCaption { color: @muted@; padding: 6px 12px 6px 0; }
QFrame#summaryField QLineEdit, QLineEdit#workRecordTitle { padding: 8px 10px; }
QScrollArea { border: none; background: transparent; }
QWidget#detailsColumn { background: transparent; }
QWidget#contentHeader { background: @surface@; border-bottom: 1px solid @border@; }
QSplitter::handle { background: transparent; }
QSplitter::handle:hover { background: @border@; border-radius: 3px; }
QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle:vertical, QScrollBar::handle:horizontal { background: @scrollHandle@; border-radius: 3px; min-height: 28px; min-width: 28px; }
QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover { background: @scrollHandleHover@; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }
QMenu { background: @surface@; border: 1px solid @controlBorder@; padding: 5px; }
QMenu::item { color: @text@; padding: 7px 26px 7px 14px; border-radius: 4px; }
QMenu::item:selected { background: @selection@; color: @selectionText@; }
QMenu::item:disabled { color: @disabled@; }
QMenu::separator { height: 1px; background: @border@; margin: 5px 8px; }
QToolTip { color: @text@; background: @surface@; border: 1px solid @controlBorder@; padding: 7px 10px; }
QProgressBar { color: @accent@; background: @hover@; border: none; border-radius: 4px; text-align: center; min-height: 18px; }
QProgressBar::chunk { background: @progress@; border-radius: 4px; }
QGroupBox { border: 1px solid @border@; border-radius: 7px; margin-top: 14px; padding: 12px; }
QGroupBox::title { subcontrol-origin: margin; left: 12px; padding: 0 5px; color: @muted@; }
QCalendarWidget { background: @indexSurface@; }
QCalendarWidget QWidget#qt_calendar_navigationbar { background: @indexSurface@; }
QCalendarWidget QToolButton { border: 1px solid transparent; background: @indexSurface@; padding: @calendarPadding@; font-size: 14px; }
QCalendarWidget QToolButton:hover { background: @hover@; }
QCalendarWidget QToolButton:focus { border-color: @focus@; }
QCalendarWidget QToolButton#qt_calendar_monthbutton { color: @text@; font-size: 18px; font-weight: 600; }
QCalendarWidget QSpinBox { min-width: 70px; }
QCalendarWidget QToolButton#qt_calendar_yearbutton, QCalendarWidget QSpinBox#qt_calendar_yearedit { color: @text@; font-size: 15px; font-weight: 600; }
QCalendarWidget QAbstractItemView { background: @indexSurface@; alternate-background-color: @indexSurface@; border: none; padding: 0; }
QCalendarWidget#workspaceCalendar QTableView { padding-bottom: @calendarBottomInset@; }
QListWidget#commandList { border: none; background: transparent; padding: 0; }
QListWidget#commandList::item { border: none; border-bottom: 1px solid @border@; border-radius: 0; padding: 0; background: @surface@; }
QListWidget#commandList::item:hover { background: @hover@; }
QListWidget#commandList::item:selected { background: @selection@; }
QListWidget#commandList::item:focus { border: 1px solid @focus@; }
QListWidget#projectList::item:selected { font-weight: 600; }
QLabel#commandName { color: @text@; font-size: 15px; font-weight: 600; }
QLabel#stateSummary { color: @text@; font-size: 14px; }
QLabel#tag, QLabel#tagDanger, QLabel#tagMuted { border-radius: 4px; padding: 2px 7px; font-size: 11px; }
QLabel#tag { color: @selectionText@; background: @selection@; }
QLabel#tagDanger { color: @danger@; background: @dangerBackground@; }
QLabel#tagMuted { color: @muted@; background: @hover@; }
QFrame#stateRow { background: @background@; border: none; border-radius: 0; }
QLabel#stateBadge, QLabel#stateItemBadge { border: none; border-radius: 5px; padding: 3px 9px; font-weight: 500; }
QLabel#stateItemBadge { font-size: 12px; padding: 2px 9px; border-radius: 9px; }
QLabel[uiRole="badgeSuccess"] { color: @success@; background: @successBackground@; }
QLabel[uiRole="badgeError"] { color: @danger@; background: @dangerBackground@; }
QLabel[uiRole="badgeActive"] { color: @selectionText@; background: @selection@; }
QLabel[uiRole="badgeMuted"] { color: @muted@; background: @hover@; }
QLabel[uiRole="badgeWarning"] { color: @warning@; background: @warningBackground@; }
QLabel#stateRowName, QLabel#commandContextTitle { font-weight: 600; }
QFrame#runPanel { background: @background@; border: none; border-radius: 0; }
QLabel#runTitle { color: @text@; font-weight: 600; }
QLabel#runStatus { font-weight: 600; }
QPlainTextEdit#runOutput { background: transparent; color: @text@; border: none; padding: 0; }
QLabel#warningText, QLabel#commandParameterError { color: @warning@; background: @warningBackground@; border: none; border-radius: 6px; padding: 8px 10px; }

QFrame#shortcutModifierSegments {
    background: @indexSurface@; border: 1px solid @controlBorder@; border-radius: @controlRadius@;
}
QFrame#shortcutModifierSegments QToolButton {
    background: transparent; color: @muted@; border: 1px solid transparent; border-radius: 4px;
    min-width: 32px; min-height: 20px; padding: 1px 5px;
}
QFrame#shortcutModifierSegments QToolButton:hover { background: @hover@; color: @text@; }
QFrame#shortcutModifierSegments QToolButton:checked {
    background: @selection@; color: @selectionText@; border-color: @border@; font-weight: 600;
}
QFrame#shortcutModifierSegments QToolButton:focus { border-color: @accent@; }
QLineEdit#globalShortcutLetter {
    min-width: 35px; max-width: 35px; min-height: 20px;
    color: @accent@; font-weight: 600;
}
QPushButton[uiRole="settingsToggle"] {
    background: transparent; border-color: transparent; color: @muted@;
    text-align: right; padding: 4px 7px 4px 38px;
}
QPushButton[uiRole="settingsToggle"]:checked:enabled { color: @text@; }
QPushButton[uiRole="settingsToggle"]:hover:enabled { background: @hover@; }
QPushButton[uiRole="settingsToggle"]:pressed:enabled { background: @selection@; }
QPushButton[uiRole="settingsToggle"]:focus { border-color: @focus@; }
QPushButton[uiRole="settingsToggle"]:disabled { color: @disabled@; }

/* Keep labels at a common reading size in both settings arrangements. */
QWidget#settingsPage QLabel, QWidget#settingsPage QComboBox,
QWidget#settingsPage QPushButton, QWidget#settingsPage QToolButton, QWidget#settingsPage QLineEdit,
QWidget#settingsPage QAbstractItemView[uiRole="appearanceOptions"], QWidget#settingsPage QTextBrowser#releaseNotes {
    font-size: 14px;
}
QWidget#settingsPage QLabel#cardTitle { font-size: 20px; min-height: 32px; }
QWidget#appearancePreview { min-height: @appearancePreviewHeight@; max-height: @appearancePreviewHeight@; }
QWidget#settingsPage QLabel#autoStartStatus, QWidget#settingsPage QLabel#globalShortcutStatus,
QWidget#settingsPage QLabel#closeToTrayStatus, QWidget#settingsPage QLabel#automaticUpdatesStatus { font-size: 14px; }
QWidget#settingsPage QLabel#installedVersion, QWidget#settingsPage QLabel#updateStatus,
QWidget#settingsPage QLabel#previousUpdateResult { font-size: 13px; color: @muted@; }
QWidget#settingsPage QWidget#updateWidget { border: none; border-radius: 0; }
QWidget#settingsPage QPushButton#manageSkinsButton {
    background: transparent; border-color: transparent; color: @accent@;
}
QWidget#settingsPage QPushButton#manageSkinsButton:hover { background: @hover@; }
QWidget#settingsPage QPushButton#manageSkinsButton:focus { border-color: @focus@; }
QWidget#settingsPage QPushButton#manageSkinsButton:pressed { background: @selection@; color: @selectionText@; }

QDialog#skinManagerDialog QLineEdit#skinSearch, QDialog#skinManagerDialog QTreeWidget#skinManagerList {
    font-size: 15px;
}
QDialog#skinManagerDialog QLabel#skinManagerStatus { font-size: 14px; }
