/* Values are resolved from ui/theme.h. This stylesheet covers every window. */
QWidget { color: @text@; selection-background-color: @selection@; selection-color: @accent@; }
QMainWindow, QWidget#root, QWidget#settingsPage { background: @surface@; }
QDialog, QMessageBox, QInputDialog { background: @surface@; }
QLabel { background: transparent; }
QFrame#sidebar { background: @sidebar@; border: none; }
QFrame#windowHeader { background: @sidebar@; border: none; border-bottom: 1px solid @border@; }
QWidget[workspaceSurface="content"], QWidget[workspaceSurface="section"] {
    background: @surface@; border: none; border-radius: 0;
}
QWidget[workspaceSurface="index"], QWidget[workspaceSurface="inset"] {
    background: @indexSurface@; border: none; border-radius: 0;
}
QWidget[workspaceSurface="section"], QWidget#updateWidget[workspaceSurface="section"] {
    background: @surface@; border: none; border-bottom: 1px solid @border@; border-radius: 0;
}
QLabel#pageTitle { color: @text@; font-size: 16px; font-weight: 600; }
QLabel#cardTitle { color: @text@; font-size: 15px; font-weight: 600; }
QLabel#toolName { color: @text@; font-size: 19px; font-weight: 600; }
QLabel#emptyStateTitle { color: @muted@; font-size: 17px; font-weight: 500; }
QLabel#muted, QLabel#pageSubtitle, QLabel#sourceText, QLabel#fieldHelp,
QLabel#recordLocation, QLabel#recordHint, QLabel#mathPreviewStatus,
QLabel#autoStartStatus, QLabel#globalShortcutStatus, QLabel#recordSaveStatus,
QLabel#outlineSaveError, QLabel#emptyViewHint {
    color: @muted@; font-size: 12px;
}
QLabel[uiRole="error"], QLabel#clipboardStatus, QLabel#outlineSaveError[uiRole="error"], QLabel#recordSaveStatus[uiRole="error"] { color: @danger@; }
QLabel[uiRole="success"], QLabel#outlineSaveError[uiRole="success"], QLabel#recordSaveStatus[uiRole="success"] { color: @success@; }
QLabel[uiRole="warning"], QLabel#recordSaveStatus[uiRole="warning"] { color: @warning@; }
QLabel[uiRole="accent"] { color: @accent@; }
QLabel#diaryLegend { color: @success@; font-size: 12px; }
QLabel#reminderLegend { color: @warning@; font-size: 12px; }
QFrame#card, QWidget#updateWidget {
    background: @surface@; border: 1px solid @border@; border-radius: 10px;
}
QPushButton, QToolButton {
    background: @surface@; color: @text@; border: 1px solid @controlBorder@;
    border-radius: 6px; padding: 6px 11px; min-height: 20px;
}
QPushButton:hover, QToolButton:hover { background: @hover@; border-color: @focus@; }
QPushButton:pressed, QToolButton:pressed { background: @selection@; border-color: @focus@; }
QPushButton:focus, QToolButton:focus { border-color: @accent@; }
QPushButton[uiRole="quiet"] { background: transparent; border-color: transparent; }
QPushButton[uiRole="quiet"]:hover { background: @hover@; }
QPushButton[uiRole="quiet"]:pressed { background: @selection@; }
QPushButton[uiRole="quiet"]:focus { border-color: @focus@; }
QPushButton:disabled, QToolButton:disabled { color: @disabled@; background: @background@; border-color: @border@; }
QPushButton#primaryButton, QPushButton[uiRole="primary"], QPushButton:default {
    background: @selection@; color: @accent@; border-color: transparent; font-weight: 600;
}
QPushButton#primaryButton:hover, QPushButton[uiRole="primary"]:hover, QPushButton:default:hover { background: #dce7f6; border-color: @focus@; }
QPushButton#primaryButton:pressed, QPushButton[uiRole="primary"]:pressed { background: #d4e1f3; }
QPushButton#primaryButton:focus:enabled, QPushButton[uiRole="primary"]:focus:enabled, QPushButton:default:focus:enabled { border-color: @accent@; }
QPushButton#primaryButton:disabled, QPushButton[uiRole="primary"]:disabled, QPushButton:default:disabled { color: @disabled@; background: @background@; border-color: @border@; }
QPushButton#dangerButton, QPushButton[uiRole="danger"], QPushButton#deleteProjectButton { color: @danger@; background: transparent; border-color: transparent; }
QPushButton#dangerButton:hover, QPushButton[uiRole="danger"]:hover, QPushButton#deleteProjectButton:hover { background: @dangerBackground@; border-color: #e6c5c5; }
QPushButton#dangerButton:focus, QPushButton[uiRole="danger"]:focus, QPushButton#deleteProjectButton:focus { border-color: @danger@; }
QPushButton[uiRole="danger"]:disabled, QPushButton#dangerButton:disabled { color: @disabled@; background: transparent; border-color: transparent; }
QPushButton#navButton { background: transparent; border: 1px solid transparent; text-align: left; padding: 10px 12px; font-size: 14px; border-radius: 7px; }
QPushButton#navButton:hover { background: #e7edef; }
QPushButton#navButton:checked { background: @selection@; color: @accent@; font-weight: 600; }
QPushButton#navButton:focus { border-color: @focus@; }
QPushButton#sidebarToggle { background: transparent; padding: 0; min-width: 28px; max-width: 28px; min-height: 28px; max-height: 28px; border-color: transparent; }
QPushButton#sidebarToggle:hover { background: #e2e8f0; }
QPushButton#sidebarToggle:pressed { background: @selection@; }
QPushButton#sidebarToggle:focus { border-color: @focus@; }
QLineEdit, QPlainTextEdit, QTextEdit, QAbstractSpinBox, QComboBox {
    background: @surface@; color: @text@; border: 1px solid @controlBorder@;
    border-radius: 6px; padding: 6px 9px; placeholder-text-color: @muted@;
}
QLineEdit:hover, QComboBox:hover, QAbstractSpinBox:hover { border-color: @focus@; }
QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus, QAbstractSpinBox:focus, QComboBox:focus { border-color: @accent@; }
QLineEdit:disabled, QAbstractSpinBox:disabled, QComboBox:disabled { color: @disabled@; background: @background@; border-color: @border@; }
QLineEdit[readOnly="true"] { background: @background@; border-color: @border@; }
QLineEdit#recordSearch, QLineEdit#clipboardSearch { background: @indexSurface@; border-color: transparent; }
QLineEdit#recordSearch:hover, QLineEdit#clipboardSearch:hover { border-color: @border@; }
QLineEdit#recordSearch:focus, QLineEdit#clipboardSearch:focus { border-color: @focus@; }
QPlainTextEdit#headingSource, QTextEdit#headingPreview { padding: 12px 14px; }
QTextEdit#headingPreview { border-color: @border@; }
QTextEdit#headingPreview:focus { border-color: @accent@; }
QToolButton#markdownSourceMode:checked { background: @selection@; color: @accent@; border-color: @focus@; }
QPlainTextEdit#clipboardPreview { background: @indexSurface@; border: none; border-radius: 0; padding: 12px; }
QTreeWidget#clipboardItems, QPlainTextEdit#clipboardPreview, QPlainTextEdit#clipboardItemBody { font-size: 18pt; }
QComboBox { padding-right: 28px; min-height: 20px; }
QComboBox::drop-down { subcontrol-origin: padding; subcontrol-position: center right; width: 26px; border: none; }
QComboBox::down-arrow { image: url(:/ui/icons/chevron-down.svg); width: 12px; height: 12px; }
QComboBox QAbstractItemView { background: @surface@; border: 1px solid @controlBorder@; padding: 4px; selection-background-color: @selection@; selection-color: @accent@; }
QAbstractSpinBox { padding-right: 24px; min-height: 20px; }
QAbstractSpinBox::up-button, QAbstractSpinBox::down-button { subcontrol-origin: border; width: 22px; border: none; border-left: 1px solid @border@; }
QAbstractSpinBox::up-button { subcontrol-position: top right; border-top-right-radius: 6px; }
QAbstractSpinBox::down-button { subcontrol-position: bottom right; border-bottom-right-radius: 6px; }
QAbstractSpinBox::up-button:hover, QAbstractSpinBox::down-button:hover { background: @selection@; }
QAbstractSpinBox::up-arrow { image: url(:/ui/icons/chevron-up.svg); width: 10px; height: 10px; }
QAbstractSpinBox::down-arrow { image: url(:/ui/icons/chevron-down.svg); width: 10px; height: 10px; }
QCheckBox, QRadioButton { spacing: 8px; padding: 3px 0; }
QCheckBox:disabled, QRadioButton:disabled { color: @disabled@; }
QCheckBox::indicator { width: 16px; height: 16px; border: 1px solid @controlBorder@; border-radius: 4px; background: @surface@; }
QCheckBox::indicator:checked { background: @selection@; border-color: @focus@; image: url(:/ui/icons/check.svg); }
QCheckBox::indicator:hover, QCheckBox::indicator:focus { border-color: @accent@; }
QCheckBox::indicator:disabled { background: @background@; border-color: @border@; }
QRadioButton::indicator { width: 16px; height: 16px; border: 1px solid @controlBorder@; border-radius: 8px; background: @surface@; }
QRadioButton::indicator:checked { background: @selection@; border-color: @focus@; image: url(:/ui/icons/radio.svg); }
QRadioButton::indicator:hover { border-color: @accent@; }
QListWidget, QTreeWidget, QTableView { background: @surface@; alternate-background-color: @background@; border: 1px solid @border@; border-radius: 6px; padding: 4px; }
QListWidget::item, QTreeWidget::item { padding: 8px 9px; border: 1px solid transparent; border-radius: 4px; }
QListWidget::item:hover, QTreeWidget::item:hover { background: @hover@; }
QListWidget::item:selected, QTreeWidget::item:selected { background: @selection@; color: @accent@; }
QListWidget::item:focus, QTreeWidget::item:focus { border-color: @focus@; }
QListWidget#projectList, QTreeWidget#workRecordList, QTreeWidget#toolTree,
QListWidget#reminderList, QListWidget#diaryList, QTreeWidget#clipboardItems { border: none; background: transparent; padding: 0; }
QTreeWidget#toolTree::item { padding: 8px 5px; }
QTreeWidget#clipboardItems::item { min-height: 30px; padding: 8px 12px; }
QTreeWidget::branch { background: transparent; }
QHeaderView::section { background: @background@; color: @muted@; border: none; border-bottom: 1px solid @border@; padding: 7px; }
QTabBar::tab { color: @muted@; background: transparent; border: 1px solid transparent; border-radius: 6px; padding: 7px 12px; margin-right: 4px; min-width: 36px; min-height: 20px; }
QTabBar::tab:hover { background: @hover@; }
QTabBar::tab:selected { color: @accent@; background: @selection@; border-color: @controlBorder@; font-weight: 600; }
QTabBar::tab:focus { border-color: @accent@; }
QTabBar#recordSectionTabs::tab:last { margin-right: 0; }
QTabBar#clipboardTabs { font-size: 11pt; }
QTabBar#clipboardTabs::tab { background: @background@; color: @text@; border: 1px solid @controlBorder@; border-radius: 6px; margin-top: 4px; margin-right: -8px; padding: 6px 20px; min-height: 22px; max-width: 220px; }
QTabBar#clipboardTabs::tab:last { margin-right: 0; }
QTabBar#clipboardTabs::tab:hover { background: @hover@; border-color: @focus@; }
QTabBar#clipboardTabs::tab:selected { background: @selection@; color: @accent@; border-color: @focus@; margin-top: 0; padding-top: 8px; padding-bottom: 8px; }
QTabBar#clipboardTabs::tab:focus { border-color: @accent@; }
QTabBar#clipboardTabs::scroller { width: 64px; }
QTabBar#clipboardTabs QToolButton { padding: 0; }
QTabWidget::pane { border: 1px solid @border@; border-radius: 6px; background: @surface@; }
QFrame#summaryField { background: @surface@; border: none; }
QLabel#summaryCaption { color: @muted@; padding: 6px 12px 6px 0; }
QFrame#summaryField QLineEdit { padding: 8px 10px; }
QScrollArea { border: none; background: transparent; }
QWidget#detailsColumn { background: transparent; }
QSplitter::handle { background: transparent; }
QSplitter::handle:hover { background: @border@; border-radius: 3px; }
QSplitter#workspaceSplit::handle { background: @border@; border-radius: 0; }
QSplitter#workspaceSplit::handle:hover { background: @focus@; }
QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle:vertical, QScrollBar::handle:horizontal { background: #c5ceda; border-radius: 3px; min-height: 28px; min-width: 28px; }
QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover { background: #9cabbf; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }
QMenu { background: @surface@; border: 1px solid @controlBorder@; padding: 5px; }
QMenu::item { color: @text@; padding: 7px 26px 7px 14px; border-radius: 4px; }
QMenu::item:selected { background: @selection@; color: @accent@; }
QMenu::item:disabled { color: @disabled@; }
QMenu::separator { height: 1px; background: @border@; margin: 5px 8px; }
QToolTip { color: @text@; background: @surface@; border: 1px solid @controlBorder@; padding: 7px 10px; }
QProgressBar { color: @accent@; background: @hover@; border: none; border-radius: 4px; text-align: center; min-height: 18px; }
QProgressBar::chunk { background: #c7d7ed; border-radius: 4px; }
QGroupBox { border: 1px solid @border@; border-radius: 7px; margin-top: 14px; padding: 12px; }
QGroupBox::title { subcontrol-origin: margin; left: 12px; padding: 0 5px; color: @muted@; }
QCalendarWidget { background: @indexSurface@; }
QCalendarWidget QWidget#qt_calendar_navigationbar { background: @indexSurface@; }
QCalendarWidget QToolButton { border: 1px solid transparent; background: @indexSurface@; padding: 7px; font-size: 14px; }
QCalendarWidget QToolButton:hover { background: @hover@; }
QCalendarWidget QToolButton:focus { border-color: @focus@; }
QCalendarWidget QSpinBox { min-width: 70px; }
QCalendarWidget QAbstractItemView { background: @indexSurface@; alternate-background-color: @indexSurface@; border: none; padding: 0; }
QListWidget#commandList { border: none; background: transparent; padding: 0; }
QListWidget#commandList::item { border: none; border-bottom: 1px solid @border@; border-radius: 0; padding: 0; background: @surface@; }
QListWidget#commandList::item:hover { background: @hover@; }
QListWidget#commandList::item:selected { background: @selection@; }
QListWidget#commandList::item:focus { border: 1px solid @focus@; }
QLabel#commandName { color: @text@; font-size: 14px; font-weight: 500; }
QLabel#stateSummary { color: @text@; font-size: 14px; }
QLabel#tag, QLabel#tagDanger, QLabel#tagMuted { border-radius: 4px; padding: 2px 7px; font-size: 11px; }
QLabel#tag { color: @accent@; background: @selection@; }
QLabel#tagDanger { color: @danger@; background: @dangerBackground@; }
QLabel#tagMuted { color: @muted@; background: @hover@; }
QFrame#stateRow { background: @background@; border: none; border-radius: 0; }
QLabel#stateRowName, QLabel#commandContextTitle { font-weight: 600; }
QFrame#runPanel { background: @background@; border: none; border-radius: 0; }
QLabel#runTitle { color: @text@; font-weight: 600; }
QPlainTextEdit#runOutput { background: transparent; color: @text@; border: none; padding: 0; }
QLabel#warningText, QLabel#commandParameterError { color: @warning@; background: @warningBackground@; border: none; border-radius: 6px; padding: 8px 10px; }
