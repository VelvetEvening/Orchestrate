# Build output
/app/build*/
/app/cmake-build-*/
# Portable release archives, staging directories and packaging checks
/dist/
/app/dist/

# Local runtimes and environment-generated directories
/Python/
/%SystemDrive%/
.venv/
venv/
__pycache__/
*.py[cod]

# Personal development settings and environment secrets
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Runtime state written by built-in tools
/app/tools/**/state/
/docs/examples/tool-adapter/state/

# Personal databases and runtime logs (keep app/src/data/ tracked)
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.log

# Track test sources; keep execution output and personal fixtures local.
/app/tests/**
!/app/tests/**/
!/app/tests/**/*.cpp
!/app/tests/**/*.h
!/app/tests/**/*.py
!/app/tests/**/*.ps1
!/app/tests/**/*.cmake
!/app/tests/**/CMakeLists.txt
!/app/tests/**/README.md
/app/tests/**/artifacts/
/app/tests/**/diagnostics/
/app/tests/**/__pycache__/

# Local AI-agent settings, memory, caches and review artifacts (at any depth).
# Shared project instructions such as AGENTS.md remain tracked.
.codex/
.claude/
.workbuddy/
.impeccable/
